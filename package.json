{
  "name": "repoverity",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Open-source public GitHub analytics, local growth tracking, achievements, issue discovery and repository advice.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:pages": "PAGES_BASE=/repoverity/ npm run build && npm run verify:pages",
    "verify:pages": "node scripts/verify-pages.mjs dist /repoverity/",
    "lint:text": "node scripts/check-no-emdash.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}

{
  "name": "repoverity",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "description": "Public GitHub developer workspace with accessible navigation, repository analysis and optional motion.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:pages": "PAGES_BASE=/repoverity/ npm run build && npm run verify:pages",
    "verify:pages": "node scripts/verify-pages.mjs dist /repoverity/",
    "lint:text": "node scripts/check-no-emdash.mjs",
    "typecheck:cloud": "tsc -p tsconfig.worker.json --noEmit",
    "test:cloud": "node --experimental-strip-types --test worker/tests/*.test-node.mjs",
    "build:cloud": "VITE_CLOUD_ENABLED=true PAGES_BASE=/ npm run build",
    "cloud:dev": "npm run build:cloud && wrangler dev --port 8787",
    "cloud:deploy": "npm run build:cloud && wrangler deploy",
    "cloud:migrate:local": "wrangler d1 migrations apply DB --local",
    "cloud:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "gsap": "3.13.0",
    "lucide-react": "^0.548.0",
    "motion": "12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.151.3"
  }
}
